    "patched_sha256": "6e99642c058fc41c79ffe6f64cad9de90f12dcaa0bf5c54fa9115feb34a4b21c",
    "patch": "    # Diagnostic-only override in this frozen workspace, never in repository source.\n    if not getattr(controller, \"_diagnostic_forced_done\", False) and \"baseline_tail_s\" in plan:\n        def required_tokens(r):\n            n = r[\"metrics\"][\"prompt_tokens\"] + r[\"metrics\"][\"max_new_tokens\"]\n            return ((n + block_tokens - 1) // block_tokens) * block_tokens\n        target_reserved = sum(required_tokens(r) for r in route[\"active\"] if r[\"rank\"] == target)\n        by_id = {r[\"request_id\"]: r for r in route[\"active\"]}\n        available = engines[target][\"queue\"][\"free_kv_tokens\"] - target_reserved\n        eligible = [x for x in plan[\"candidates\"] if x[\"computed_tokens_exact\"]\n                    and any(a[\"method\"] == \"kv\" for a in x[\"alternatives\"])\n                    and required_tokens(by_id[x[\"request_id\"]]) <= available]\n        if eligible:\n            item = min(eligible, key=lambda x: x[\"computed_tokens_used\"])\n            choice = next(a for a in item[\"alternatives\"] if a[\"method\"] == \"kv\")\n            plan.update(selected=[dict(request_id=item[\"request_id\"], **choice)],\n                        net_predicted_gain_s=999.0, reason=\"diagnostic_forced_not_a_performance_result\")\n            controller._diagnostic_forced_done = True\n"
  }
